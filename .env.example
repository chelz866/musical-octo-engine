# Host path to your ao3downloader downloads folder (contains the .epub files)
DOWNLOAD_DIR=/path/to/ao3downloader/downloads

# Host path to the folder containing ao3downloader's log.jsonl
LOG_DIR=/path/to/ao3downloader/logs

# Host path for this app's own small SQLite file (manual overrides/dismissals).
# Needs to be writable, unlike the two read-only folders above.
DATA_DIR=/path/to/ao3-viewer-data

# Port exposed on the host
HOST_PORT=8000

# How often (seconds) feeds with auto-refresh enabled are checked in the
# background. Uncomment to change; defaults to 1 hour.
# AUTO_REFRESH_INTERVAL_SECONDS=3600

# Optional: link downloaded works to their Audiobookshelf copy, if any.
# All three must be set (and the volume line in docker-compose.yml
# uncommented) to enable this -- leave commented out to disable it.
# Host path to Audiobookshelf's own absdatabase.sqlite (read-only mount).
# ABS_DB_HOST_PATH=/path/to/audiobookshelf/config/absdatabase.sqlite
# The Audiobookshelf library id that holds your AO3 fics (see its Library
# Settings, or the "library" field in its URL).
# ABS_LIBRARY_ID=89973a2b-bced-4abc-8c74-d8672154c5d7
# Your Audiobookshelf base URL, including any reverse-proxy path prefix --
# whatever precedes "/item/..." when you open a book in its web UI.
# ABS_BASE_URL=http://your-server:13378/audiobookshelf
